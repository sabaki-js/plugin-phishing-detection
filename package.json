{
  "name": "@sabaki-js/phishing-detection",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Sabaki plugin - multilingual phishing detection, latin scripts (MiniLM cross-encoder, bundled weights).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabaki-js/plugin-phishing-detection.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "models",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json && cp src/manifest.json src/weights.json dist/",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test.js",
    "publish-package": "bash ./scripts/publish-package.sh"
  },
  "peerDependencies": {
    "sabaki": "^1.0.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.12",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.58.2"
  },
  "keywords": [
    "sabaki",
    "sabaki-plugin",
    "phishing",
    "security"
  ],
  "author": "fox3000foxy"
}